# ==============================================================================
# SMART ECO BIN — Environment Configuration Example (.env.example)
# Copy to .env for local development. Never commit sensitive keys to git.
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Configuration
# ------------------------------------------------------------------------------
# Storage Provider Selection: 'local' (default development JSON ledger) or 'firestore'
STORAGE_PROVIDER=local
# Optional local JSON ledger path (relative to backend/ when the API starts).
# Leave unset to use backend/data/classification_records.json.
# LOCAL_STORAGE_FILE=data/classification_records.json

# Google Cloud Platform & Firestore Configuration (Required when STORAGE_PROVIDER=firestore)
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
FIRESTORE_COLLECTION=waste_records

# Local Google Cloud Authentication (Leave empty to use native Application Default Credentials)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# Optional: Private Cloud Storage for Image Archival (Default: false for zero-retention privacy)
GCS_IMAGE_STORAGE_ENABLED=false
GCS_BUCKET_NAME=smart-eco-bin-audit-images

# AI Model Paths (Defaults relative to project root)
MODEL_PATH=ml/model/waste_model.pth
METADATA_PATH=ml/metadata/model_metadata.json
DETECTOR_MODEL_PATH=ml/model/waste_detector.pt
DETECTION_CONFIDENCE_THRESHOLD=0.40
DETECTION_IOU_THRESHOLD=0.45
ROUTING_UNCERTAINTY_THRESHOLD=60.0

# Optional: Google Gemini API Key for WasteAI and SanitationAI assistants
GEMINI_API_KEY=

# Server Port (Cloud Run dynamically injects $PORT)
PORT=8001

# CORS Allowed Origins (Comma-separated list of origins permitted to call backend API)
# In development: defaults to http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
# In Cloud Run: set to https://<frontend-cloud-run-service-url>
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ------------------------------------------------------------------------------
# Environment Profile
# ------------------------------------------------------------------------------
# Operating environment: 'development' (local workstation) or 'production' (Cloud Run)
# In production, strict security validations are enforced on startup.
ENVIRONMENT=development

# ------------------------------------------------------------------------------
# Authentication & Role-Based Access Control (RBAC) Configuration
# ------------------------------------------------------------------------------
# Identity Provider:
# - 'auto': Auto-detects Firebase/GCP credentials, falls back to local HMAC in dev
# - 'firebase': Production Google Firebase Authentication (requires GOOGLE_CLOUD_PROJECT)
# - 'oidc': Production Google Cloud Identity Platform / Workspace OIDC
# - 'development': Local HMAC token evaluation (FORBIDDEN in production)
AUTH_PROVIDER=auto

# Server-Side Authorized Administrator Emails (Comma-separated list):
# In production: Specify verified institutional administrator emails (e.g., admin@sanitation.gov).
# Placeholder emails (e.g. admin@ecosortai.com) are REJECTED at startup in production.
ADMIN_EMAILS=admin@ecosortai.com

# Allow Cryptographically Signed Development Tokens:
# - Development: 'true' enables local token issuance and demonstration authentication.
# - Production: MUST be 'false'. Setting to 'true' in production immediately halts startup.
ALLOW_DEV_AUTH=true

# Secret key used to sign and verify local development tokens (Minimum 32 bytes):
# [DEV ONLY] In production, this key is deactivated. Known public demo keys are rejected.
JWT_DEV_SECRET=replace-with-a-random-local-development-secret-at-least-32-bytes

# Trusted Proxy IP List (Comma-separated):
# Only proxies in this list are allowed to forward X-Forwarded-For client IP addresses.
# Prevents client IP spoofing against the /api/predict rate limiter.
TRUSTED_PROXIES=

# Optional: Legacy administrative API key guard
ADMIN_API_KEY=

# ------------------------------------------------------------------------------
# Frontend Configuration (Vite)
# ------------------------------------------------------------------------------
# Base URL for backend API Gateway (Leave empty in development if using Vite proxy)
# In production Cloud Run: set to https://<backend-cloud-run-service-url>
VITE_API_BASE_URL=http://localhost:8001
